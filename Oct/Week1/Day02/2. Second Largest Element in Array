class Solution:
    def getSecondLargest(self, arr):
        # code here
        largest = float("-inf")
        second_largest = float("-inf")
        
        for num in arr:
            if num > largest:
                largest = num
            
        for num in arr:
            if num < largest:
                if num > second_largest:
                    second_largest = num
                    
        return second_largest

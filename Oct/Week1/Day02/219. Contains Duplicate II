class Solution:
    def containsNearbyDuplicate(self, nums: list[int], k: int) -> bool:
        list_dic = {}
        for i in range(len(nums)):
            if nums[i] in list_dic:
                distance = abs(list_dic[nums[i]] - i)
                if distance <= k:
                    return True
            list_dic[nums[i]] = i
        return False
                


        

class Solution:
    def countFreq(self, arr):
        #code here
        dic = {}
        final_list = []
        for num in arr:
            if num in dic:
                dic[num] = dic[num] + 1 
            else:
                dic[num] = 1 
        for num , count in dic.items():
            final_list.append([num, count])
        return final_list
            

class Solution:
    def twoSumLessThanK(self, nums: list[int], k: int) -> int:
        nums.sort()
        largest_total = float("-inf")
        n = len(nums)
        i = 0
        j = n - 1
        
        while i < j:
            total = nums[i] + nums[j]
            if total < k:
                if total > largest_total:
                    largest_total = total
                i += 1
            else:
                j -= 1
        if largest_total == float("-inf"):
            return -1
        else:
            return largest_total

    

            
                
